{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "agentbox-llama"
  ],
  "provider": {
    "agentbox-llama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp locale",
      "options": {
        "baseURL": "https://host.docker.internal:8080/v1",
        "timeout": false
      },
      "models": {
        "qwen36-35b-q3": {
          "name": "Qwen3.6 35B A3B Q3",
          "limit": {
            "context": 16384,
            "output": 2048
          }
        }
      }
    }
  },
  "model": "agentbox-llama/qwen36-35b-q3",
  "permission": {
    "*": "deny",
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "ask",
    "external_directory": "deny"
  },
  "agent": {
    "title": {
      "disable": true
    }
  },
  "compaction": {
    "auto": true,
    "prune": true
  },
  "autoupdate": false,
  "share": "disabled"
}
